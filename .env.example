# Clé MAP_KEY gratuite, obtenue par e-mail auprès de NASA FIRMS.
# Copie ce fichier en .env et remplace la valeur ci-dessous.
FIRMS_MAP_KEY=

# Port HTTP local (optionnel, défaut : 4174).
# PORT=4174

# PostgreSQL pour les archives historiques (optionnel pour la carte live).
# Exemple local :
# DATABASE_URL=postgresql://veille_feux:mot_de_passe@localhost:5432/veille_feux
# DATABASE_POOL_SIZE=10
